{
  "name": "neon-tanks",
  "version": "1.0.0",
  "private": true,
  "description": "Neon Tanks: Arena Battle — web + iOS/Android (Capacitor)",
  "type": "module",
  "scripts": {
    "serve": "python3 -m http.server 8080 --directory public",
    "test": "playwright test",
    "sync": "cap sync",
    "assets": "capacitor-assets generate --iconBackgroundColor '#05070e' --splashBackgroundColor '#05070e'",
    "vendor": "esbuild tools/supabase-entry.js --bundle --format=esm --minify --platform=browser --outfile=public/vendor/supabase.js"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capgo/native-purchases": "8.9.6"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "1.56.0",
    "@supabase/supabase-js": "^2.117.2",
    "esbuild": "^0.28.2",
    "smtp-server": "3.19.21"
  }
}
